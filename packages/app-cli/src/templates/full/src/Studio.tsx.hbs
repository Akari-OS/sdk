/**
 * {{appName}} Studio — AKARI-HUB-088 §2-1 の AppLayout を使った画面骨格。
 *
 * 統一感の土台（ペイン枠・折り畳み・リサイズ永続・ショートカット）は Shell / shell-ui が提供する。
 * このファイルでは各ペインの「中身」だけを実装すればよい（profile="{{profile}}"）。
 *   - left   : 素材 / プリセット（MaterialPanel）
 *   - center : 編集面（このアプリ固有の Canvas）
 *   - right  : インスペクター（InspectorShell）
 *   - chat   : AI チャット（AIChatPanel）
 *   - bottom : タイムライン / トラック（時間軸を持つアプリのみ）
 */
import { useEffect, useState } from "react"
import {
  AppLayout,
  createShortcutRegistry,
  COMMON_SHORTCUTS,
} from "@akari-os/shell-ui"

// アプリ横断ショートカット（undo/redo/save/export 等）+ 固有ショートカットをここに足す。
const shortcuts = createShortcutRegistry("{{appShortId}}", [...COMMON_SHORTCUTS])

export interface StudioProps {
  /**
   * 実効 workId。AppInstance 経由起動時は compositeId（`${work_id}__inst__${app_instance_id}`）。
   * **ローカル state（localStorage / IndexedDB）はこの id をキーに持つこと**（per-instance 分離）。
   * `undefined` の間は「アプリ内 Work 一覧（chooser）」を出さず待機表示にする（Shell が SSOT）。
   */
  workId?: string
  variantId?: string
  workPoolLibrary?: string
  onBack?: () => void
  toast?: (message: string, kind?: "info" | "success" | "error") => void
}

function Placeholder({ label }: { label: string }) {
  return (
    <div className="flex h-full items-center justify-center p-4 text-center text-xs text-muted-foreground">
      {label}
    </div>
  )
}

export function Studio({ workId }: StudioProps) {
  const [showShortcuts, setShowShortcuts] = useState(false)

  // ルート keydown を registry に流す（マッチした id ごとにアクションを実行）。
  useEffect(() => {
    const onKey = (e: KeyboardEvent) => {
      const id = shortcuts.handleKeyDown(e)
      if (!id) return
      // TODO: id（"undo" / "redo" / "save" / "export" ...）に応じてアクションを実行
    }
    window.addEventListener("keydown", onKey)
    return () => window.removeEventListener("keydown", onKey)
  }, [])

  return (
    <>
      <AppLayout
        profile="{{profile}}"
        appId="{{appShortId}}"
        left={<Placeholder label="左: 素材 / プリセット（MaterialPanel をここに）" />}
        center={<Placeholder label="中央: {{appName}} の編集面をここに実装" />}
        right={<Placeholder label="右: インスペクター（InspectorShell）" />}
        chat={<Placeholder label="AI チャット（AIChatPanel）" />}
        bottom={<Placeholder label="下段: タイムライン / トラック" />}
        footer={
          <div className="flex items-center gap-3 px-3 py-1 text-[10px] text-muted-foreground">
            <span>Work: {workId ?? "—"}</span>
            <button
              type="button"
              className="hover:text-foreground"
              onClick={() => setShowShortcuts(true)}
            >
              ⌨ ショートカット
            </button>
          </div>
        }
      />
      <shortcuts.ShortcutsDialog
        open={showShortcuts}
        onClose={() => setShowShortcuts(false)}
      />
    </>
  )
}
