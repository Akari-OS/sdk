/**
 * {{appName}} — entry point（Shell mount 用）。
 *
 * Shell が dynamic import → AppHost が default export を mount する（Video / Synth と同じパターン）。
 * 本ファイルは AKARI-HUB-088 §4 の標準起動フローの雛形:
 *   1. Work 解決（workContext.work_id 優先 / self-heal）
 *   2. 上部バーへ固有アクションを登録（戻る・Work 名は Shell 所有）
 *   3. preview-cache CustomEvent を Shell の WorkHome カードへ送る（任意）
 *   4. <Studio/> をレンダー（中身だけ実装すればよい）
 *
 * react / react-dom / @akari-os/* は Shell bundle で共有されるため build 時 external 化（vite.config.ts）。
 */
import { useEffect } from "react"
import { Studio } from "./Studio"
import "./styles.css"

/** Shell（AppHost）が default export に渡す Full Tier App props（HUB-088 §4）。 */
export interface FullTierAppProps {
  /** Work ホームに戻る。単体 dev では未指定。 */
  onBack?: () => void
  /** トースト通知。 */
  toast?: (message: string, kind?: "info" | "success" | "error") => void
  /** 現在の Work コンテキスト（work_id / variant_id / 所有 Pool）。 */
  workContext?: {
    work_id?: string
    variant_id?: string
    work_pool_library?: string
  }
  /** 上部バーへ固有アクションを登録するコールバック（AppHost 経由）。 */
  setHeaderActions?: (
    actions: Array<{
      id: string
      label: string
      icon?: string
      variant?: "primary" | "secondary"
      disabled?: boolean
      title?: string
      onClick: () => void
    }>,
  ) => void
}

export default function App({
  onBack,
  toast,
  workContext,
  setHeaderActions,
}: FullTierAppProps = {}) {
  // 2. 上部バーへ固有アクションを登録（例: 書き出し）。不要なら空配列でよい。
  useEffect(() => {
    if (!setHeaderActions) return
    setHeaderActions([
      // { id: "export", label: "書き出し", icon: "⬇", variant: "primary",
      //   onClick: () => { /* TODO */ } },
    ])
    return () => setHeaderActions([])
  }, [setHeaderActions])

  // 1. Work 解決はここで（workContext.work_id を優先）。
  //    self-heal: work 未確定なら null を返してリトライする等は実装時に追加。

  return (
    <Studio
      workId={workContext?.work_id}
      variantId={workContext?.variant_id}
      workPoolLibrary={workContext?.work_pool_library}
      onBack={onBack}
      toast={toast}
    />
  )
}

export { Studio }
