# AKARI App Manifest — spec AKARI-HUB-024 §6.5 / AKARI-HUB-088（Full Tier scaffold）
# Generated by akari-app-cli (tier: full, profile: {{profile}})

[app]
id         = "{{appId}}"
name       = "{{appName}}"
version    = "0.1.0"
author     = "{{author}}"
tier       = "full"               # Full Tier: 独立 React アプリ（Shell が dist/index.js を mount）
sdk        = "{{sdkRange}}"        # Core SDK 互換レンジ（HUB-024 §6.5）
category   = "{{category}}"        # 例: publishing / documents / design / asset-generation / research / translation / analytics / notification / storage / commerce / community
profile    = "{{profile}}"         # AppLayout プロファイル（studio=4ペイン / compact=2分割）

# Shell API 互換範囲 (AKARI-HUB-108)
[compat]
shell_api = "^0.1"

[permissions]
# Default deny — このアプリが実際に使うものだけ宣言する（HUB-024 §6.7 rule 5）
pool             = ["read", "write"]
mcp              = ["pool_list_pools", "pool_search_items"]
external-network = false           # 必要なら許可ドメインの配列にする

[panels.main]
# Shell は build 成果物 dist/index.js を mount する（runtime-app-loader）。
title = "{{appName}}"
mount = "dist/index.js"
