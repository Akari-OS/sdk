{
  "name": "@akari-os/sdk",
  "version": "0.1.0",
  "description": "AKARI OS App SDK — types + Phase 1 runtime (mcp / pool / models / chat-context / ui-hooks / partner)",
  "license": "MIT",
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./agent": "./src/agent.ts",
    "./memory": "./src/memory.ts",
    "./context": "./src/context.ts",
    "./ui": "./src/ui.ts",
    "./inter-app": "./src/inter-app.ts",
    "./permission": "./src/permission.ts",
    "./skill": "./src/skill.ts",
    "./panel-schema": "./src/panel-schema.ts",
    "./manifest": "./src/manifest.ts",
    "./errors": "./src/errors.ts",
    "./compatibility": "./src/compatibility.ts",
    "./mcp": "./src/mcp.ts",
    "./pool": "./src/pool.ts",
    "./material": "./src/material.ts",
    "./slot": "./src/slot.ts",
    "./work-context": "./src/work-context.ts",
    "./models": "./src/models.ts",
    "./model-store": "./src/model-store.ts",
    "./chat-context": "./src/chat-context.ts",
    "./ui-hooks": "./src/ui-hooks.ts",
    "./partner": "./src/partner.ts",
    "./generated": "./src/generated/index.ts",
    "./schemas/*": "./schemas/*"
  },
  "files": [
    "src/",
    "dist/",
    "schemas/"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.ts",
    "prepublishOnly": "node ../../scripts/copy-compat-schema.mjs && pnpm run build"
  },
  "peerDependencies": {
    "@tauri-apps/api": "^2",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@tauri-apps/api": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true },
    "typescript": { "optional": true }
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "zod": "^3.25"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Akari-OS/sdk",
    "directory": "packages/sdk-types"
  }
}
