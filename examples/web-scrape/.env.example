# Web Scrape — HUB-104 §6-2 [scrape_config] tuning (all optional).
# The MCP server falls back to spec defaults when these are unset.

# Interval engine — "exponential" (default) | "lognormal" | "uniform" | "fixed".
# "fixed" is a time-series fingerprint and is discouraged in production.
SCRAPE_INTERVAL_MODE=exponential
SCRAPE_INTERVAL_BASE_MS=3000
SCRAPE_INTERVAL_JITTER_MS=1500
SCRAPE_INTERVAL_MIN_MS=1000
SCRAPE_INTERVAL_MAX_MS=30000
SCRAPE_DOMAIN_COOLDOWN_MS=10000

# Concurrency / backoff
SCRAPE_MAX_CONCURRENCY_PER_DOMAIN=1
SCRAPE_GLOBAL_MAX_CONCURRENCY=5
SCRAPE_BACKOFF_BASE_SEC=2
SCRAPE_BACKOFF_CAP_SEC=120
SCRAPE_BACKOFF_MAX_RETRIES=5

# Circuit breaker / session
SCRAPE_CIRCUIT_BREAKER_THRESHOLD=0.3
SCRAPE_CIRCUIT_BREAKER_OPEN_SEC=300
SCRAPE_SESSION_ACTION_LIMIT=50

# Politeness / stealth
SCRAPE_RESPECT_ROBOTS_TXT=true
SCRAPE_STEALTH_ENGINE=patchright
SCRAPE_HEADLESS=true
# SCRAPE_USER_AGENT=AkariResearchBot/1.0 (+https://akari-oss.app/bot)
